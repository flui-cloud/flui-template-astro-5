---
import Layout from '../layouts/Layout.astro';

const appName = import.meta.env.APP_NAME ?? 'Flui Demo Astro';
const appVersion = import.meta.env.APP_VERSION ?? '1.0.0';
---

<Layout title={appName}>
  <main>
    <div class="hero">
      <div class="badge">Deployed with Flui Cloud</div>
      <h1>{appName}</h1>
      <p class="subtitle">
        Your Astro 5 app is live. Start building in <code>src/pages/</code>.
      </p>
      <div class="meta">
        <span>v{appVersion}</span>
        <span>·</span>
        <span>Astro 5</span>
        <span>·</span>
        <span>Static</span>
      </div>
    </div>
  </main>
</Layout>

<style>
  main {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100dvh;
    padding: 2rem;
  }

  .hero {
    text-align: center;
    max-width: 560px;
  }

  .badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #a78bfa;
    background: rgba(167, 139, 250, 0.1);
    border: 1px solid rgba(167, 139, 250, 0.25);
    border-radius: 999px;
    padding: 0.25rem 0.75rem;
    margin-bottom: 1.5rem;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    line-height: 1.15;
    margin-bottom: 1rem;
  }

  .subtitle {
    font-size: 1.05rem;
    color: #9090a0;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  code {
    font-family: 'SF Mono', 'Fira Code', monospace;
    font-size: 0.9em;
    background: rgba(255, 255, 255, 0.07);
    padding: 0.1em 0.4em;
    border-radius: 4px;
  }

  .meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: #606070;
  }
</style>
